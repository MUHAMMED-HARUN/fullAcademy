<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="System.Application\**" />
    <Compile Remove="System.Domain\**" />
    <Compile Remove="System.Infrastructure\**" />
    <Content Remove="System.Application\**" />
    <Content Remove="System.Domain\**" />
    <Content Remove="System.Infrastructure\**" />
    <EmbeddedResource Remove="System.Application\**" />
    <EmbeddedResource Remove="System.Domain\**" />
    <EmbeddedResource Remove="System.Infrastructure\**" />
    <None Remove="System.Application\**" />
    <None Remove="System.Domain\**" />
    <None Remove="System.Infrastructure\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.17" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.17">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="9.0.6" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="9.0.6" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="9.0.6" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="System.Application\System.Application.csproj" />
    <ProjectReference Include="System.Domain\System.Domain.csproj" />
    <ProjectReference Include="System.Infrastructure\System.Infrastructure.csproj" />
  </ItemGroup>

</Project>
